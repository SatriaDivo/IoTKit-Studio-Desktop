{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IoTKit Studio",
  "version": "0.1.0",
  "identifier": "com.iotkitstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IoTKit Studio",
        "width": 1180,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost http://127.0.0.1:47831"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
